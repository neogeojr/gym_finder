# Copy this file to .env.local and fill in your own values.
# .env.local is never committed. Do not put real passwords or secrets in this example file.

# MongoDB connection string: a local MongoDB or a MongoDB Atlas address.
MONGODB_URI=mongodb://127.0.0.1:27017

# The database the app uses. DB_TEST_NAME is used instead when the tests run, so tests never touch real data.
DB_NAME=gym_finder
DB_TEST_NAME=gym_finder_test

# Signs the login cookie. Use a long random string. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
